# ki-bridge reads API keys from environment variables only. The code never reads this file.
# Copy these two lines into ~/.zshenv (macOS, zsh) and insert your own keys.
# ~/.zshenv is loaded by every zsh, including when the Claude desktop app starts the server.

export OPENAI_API_KEY="sk-your-openai-key"
export GEMINI_API_KEY="your-gemini-key-from-ai-studio"

# Optional overrides
# export KI_BRIDGE_HOME="$HOME/.ki-bridge"      # where balance and usage log are stored (default: ./state)
# export KI_BRIDGE_DOWNLOADS="$HOME/Downloads"   # folder watched during file handoffs
